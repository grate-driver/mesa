VERT
PROPERTY NEXT_SHADER FRAG
DCL IN[0]
DCL IN[1]
DCL OUT[0], POSITION
DCL OUT[1].xy, GENERIC[9]
DCL CONST[0][0..3]
DCL TEMP[0]
  0: MUL TEMP[0], CONST[0][1], IN[0].yyyy
  1: MAD TEMP[0], CONST[0][0], IN[0].xxxx, TEMP[0]
  2: MAD TEMP[0], CONST[0][2], IN[0].zzzz, TEMP[0]
  3: ADD OUT[0], TEMP[0], CONST[0][3]
  4: MOV OUT[1].xy, IN[1].xyxx
  5: END
